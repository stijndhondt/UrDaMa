{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "core": {
      "projectType": "library",
      "root": "projects/core",
      "sourceRoot": "projects/core/src",
      "prefix": "lk",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/core/tsconfig.spec.json",
            "runnerConfig": "projects/core/vitest.config.mts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/core/**/*.ts", "projects/core/**/*.html"]
          }
        }
      }
    },
    "editor2d": {
      "projectType": "library",
      "root": "projects/editor2d",
      "sourceRoot": "projects/editor2d/src",
      "prefix": "lk",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/editor2d/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/editor2d/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/editor2d/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/editor2d/**/*.ts", "projects/editor2d/**/*.html"]
          }
        }
      }
    },
    "render3d": {
      "projectType": "library",
      "root": "projects/render3d",
      "sourceRoot": "projects/render3d/src",
      "prefix": "lk",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/render3d/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/render3d/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/render3d/tsconfig.spec.json",
            "runnerConfig": "projects/render3d/vitest.config.mts",
            "include": ["../src/**/*.spec.ts", "../worker/src/**/*.spec.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/render3d/**/*.ts", "projects/render3d/**/*.html"]
          }
        }
      }
    },
    "web": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/web",
      "sourceRoot": "projects/web/src",
      "prefix": "lk",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/web/src/main.ts",
            "tsConfig": "projects/web/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/web/public"
              },
              {
                "glob": "manifold.wasm",
                "input": "node_modules/manifold-3d"
              }
            ],
            "styles": ["projects/web/src/styles.css"],
            "allowedCommonJsDependencies": ["@messageformat/core"],
            "externalDependencies": ["node:module"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.3MB",
                  "maximumError": "1.6MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "web:build:production"
            },
            "development": {
              "buildTarget": "web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/web/**/*.ts", "projects/web/**/*.html"]
          }
        }
      }
    }
  }
}
